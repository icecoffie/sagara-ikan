# Real configuration (contains DB credentials) — never commit.
/app/config/config.php

# Composer (optional libs only; core app is zero-dependency)
/vendor/
composer.lock

# User-uploaded content
/assets/uploads/*
!/assets/uploads/.gitkeep
!/assets/uploads/.htaccess

# Deploy artifacts (don't commit the zip/logs created on the server)
DEPLOYMENT.zip
error_log
php_errorlog

# OS / editor noise
.DS_Store
Thumbs.db
*.log

# Python tooling for docs generation
docs/.venv/
__pycache__/
*.pyc
